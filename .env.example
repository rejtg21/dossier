# Contact form — all three are required for /api/contact to send.
# Set them in the Vercel dashboard (Project → Settings → Environment Variables),
# and locally in .env.local for `vercel dev`. Never commit real values.

# The Gmail address that authenticates. Gmail forces it to be the sender, so
# messages arrive from here with the visitor's address as reply-to.
GMAIL_USER=

# A 16-character Google App Password, NOT the account password.
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Where submissions are delivered. May be the same as GMAIL_USER.
CONTACT_TO_EMAIL=
